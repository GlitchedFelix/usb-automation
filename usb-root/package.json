{
  "name": "usb-llm-agent",
  "version": "1.0.0",
  "description": "Portable LLM agent runtime bridged over USB between PC and Android phone",
  "main": "bridge/bridge.js",
  "scripts": {
    "bridge": "node bridge/bridge.js",
    "runtime": "node runtime/server.js",
    "find-phone": "node find_phone.js",
    "start": "node bridge/bridge.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "clipboardy": "^3.0.0",
    "express": "^4.18.3",
    "http-proxy-middleware": "^2.0.6",
    "node-fetch": "^2.7.0",
    "node-notifier": "^10.0.1",
    "uuid": "^9.0.1"
  },
  "pkg": {
    "assets": [
      "static/**/*",
      "runtime/plugins/**/*",
      "bridge/config.json",
      "bridge/logs/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
